- content_for :title, 'ログイン'
.row.justify-content-center
  .col-md-8.col-lg-6
    .card.shadow-sm
      .card-body.p-4
        %h1.h4.mb-4 ログイン
        = simple_form_for resource, as: resource_name, url: session_path(resource_name) do |f|
          = f.input :email, required: true, autofocus: true, input_html: { autocomplete: 'email' }
          = f.input :password, required: true, input_html: { autocomplete: 'current-password' }
          = f.input :remember_me, as: :boolean
          = f.button :submit, 'ログイン', class: 'btn-primary w-100', data: { turbo_submits_with: 'ログイン中…' }
        %p.text-center.mt-4.mb-0
          はじめての方は #{link_to '新規登録', new_user_registration_path}
