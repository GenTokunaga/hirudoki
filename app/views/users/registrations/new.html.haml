- content_for :title, '新規登録'
.row.justify-content-center
  .col-md-8.col-lg-6
    .card.shadow-sm
      .card-body.p-4
        %h1.h4.mb-4 新規登録
        = form_with model: resource, as: resource_name, url: user_registration_path do |f|
          = render 'shared/form_errors', record: resource
          .mb-3
            = f.label :name, class: 'form-label'
            = f.text_field :name, autofocus: true, autocomplete: 'name', required: true, maxlength: 50, class: 'form-control'
          .mb-3
            = f.label :email, class: 'form-label'
            = f.email_field :email, autocomplete: 'email', required: true, class: 'form-control'
          .mb-3
            = f.label :phone_number, class: 'form-label'
            = f.telephone_field :phone_number, autocomplete: 'tel', required: true, class: 'form-control',
                                               aria: { describedby: 'phone-number-help' }
            .form-text#phone-number-help 配達時の連絡先です。例：090-1234-5678
          .mb-3
            = f.label :password, class: 'form-label'
            = f.password_field :password, autocomplete: 'new-password', required: true, class: 'form-control',
                                          aria: { describedby: 'password-help' }
            .form-text#password-help
              = @minimum_password_length
              文字以上で入力してください。
          .mb-4
            = f.label :password_confirmation, class: 'form-label'
            = f.password_field :password_confirmation, autocomplete: 'new-password', required: true, class: 'form-control'
          = f.submit '登録する', class: 'btn btn-primary w-100', data: { turbo_submits_with: '登録中…' }
        %p.text-center.mt-4.mb-0
          登録済みの方は #{link_to 'ログイン', new_user_session_path}
