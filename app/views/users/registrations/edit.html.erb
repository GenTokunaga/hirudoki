<% content_for :title, "アカウント" %>

<div class="row justify-content-center">
  <div class="col-md-8 col-lg-6">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <h1 class="h4 mb-4">アカウント</h1>

        <%= form_with model: resource, as: resource_name, url: user_registration_path, method: :patch do |f| %>
          <%= render "shared/form_errors", record: resource %>

          <div class="mb-3">
            <%= f.label :name, class: "form-label" %>
            <%= f.text_field :name, autocomplete: "name", required: true, maxlength: 50, class: "form-control" %>
          </div>

          <div class="mb-3">
            <%= f.label :email, class: "form-label" %>
            <%= f.email_field :email, autocomplete: "email", required: true, class: "form-control" %>
          </div>

          <div class="mb-3">
            <%= f.label :phone_number, class: "form-label" %>
            <%= f.telephone_field :phone_number, autocomplete: "tel", required: true, class: "form-control" %>
          </div>

          <fieldset class="border rounded p-3 mb-3">
            <legend class="fs-6 float-none w-auto px-1 mb-0">パスワードを変更する場合のみ</legend>
            <div class="mb-3">
              <%= f.label :password, "新しいパスワード", class: "form-label" %>
              <%= f.password_field :password, autocomplete: "new-password", class: "form-control" %>
            </div>
            <div>
              <%= f.label :password_confirmation, "新しいパスワード（確認）", class: "form-label" %>
              <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control" %>
            </div>
          </fieldset>

          <div class="mb-4">
            <%= f.label :current_password, class: "form-label" %>
            <%= f.password_field :current_password, autocomplete: "current-password", required: true, class: "form-control",
                                 aria: { describedby: "current-password-help" } %>
            <div id="current-password-help" class="form-text">変更を保存するには、現在のパスワードが必要です。</div>
          </div>

          <%= f.submit "保存する", class: "btn btn-primary w-100", data: { turbo_submits_with: "保存中…" } %>
        <% end %>
      </div>
    </div>
  </div>
</div>
