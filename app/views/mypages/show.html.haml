- content_for :title, 'マイページ'
%h1.h4.mb-3 マイページ
%section.card.shadow-sm.mb-4
  .card-body
    .d-flex.flex-wrap.justify-content-between.align-items-center.gap-2.mb-2
      %h2.h5.mb-0 アカウント情報
      = link_to 'アカウント情報を変更する', edit_user_registration_path, class: 'btn btn-sm btn-outline-secondary'
    %dl.row.mb-0{ data: { test_id: 'account-info' } }
      %dt.col-sm-3= User.human_attribute_name(:name)
      %dd.col-sm-9= current_user.name
      %dt.col-sm-3= User.human_attribute_name(:email)
      %dd.col-sm-9= current_user.email
      %dt.col-sm-3= User.human_attribute_name(:phone_number)
      %dd.col-sm-9.mb-0= current_user.phone_number
%section
  %h2.h5.mb-3 注文履歴
  - if @orders.empty?
    %p.text-body-secondary
      まだ注文はありません。
      = link_to '献立から注文する', root_path
  - else
    .table-responsive.bg-white.border.rounded
      %table.table.align-middle.mb-0
        %thead.text-nowrap
          %tr
            %th{ scope: 'col' } 提供日
            %th{ scope: 'col' } 弁当
            %th.text-end{ scope: 'col' }= Order.human_attribute_name(:quantity)
            %th.text-end{ scope: 'col' } 合計金額（税込）
            %th{ scope: 'col' }= Order.human_attribute_name(:status)
        %tbody
          - @orders.each do |order|
            %tr{ data: { test_id: dom_id(order) } }
              %td.text-nowrap= link_to I18n.l(order.daily_menu.served_on, format: :with_wday), order_path(order)
              %td.text-nowrap= order.daily_menu.bento.name
              %td.text-end.text-nowrap #{order.quantity} 個
              %td.text-end.text-nowrap= number_to_currency(order.total_price)
              %td= order_status_badge(order)
