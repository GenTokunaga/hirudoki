<% content_for :title, "管理者ログイン" %>

<div class="row justify-content-center">
  <div class="col-md-8 col-lg-6">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <h1 class="h4 mb-4">管理者ログイン</h1>

        <%= form_with model: resource, as: resource_name, url: session_path(resource_name) do |f| %>
          <div class="mb-3">
            <%= f.label :email, class: "form-label" %>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "form-control" %>
          </div>

          <div class="mb-4">
            <%= f.label :password, class: "form-label" %>
            <%= f.password_field :password, autocomplete: "current-password", required: true, class: "form-control" %>
          </div>

          <%= f.submit "ログイン", class: "btn btn-dark w-100", data: { turbo_submits_with: "ログイン中…" } %>
        <% end %>
      </div>
    </div>
  </div>
</div>
