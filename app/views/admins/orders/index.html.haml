- content_for :title, '注文'
%h1.h4.mb-3 注文
%nav.d-flex.justify-content-between.align-items-center.mb-3{ 'aria-label': '表示する提供日' }
  = link_to '‹ 前の日', admins_orders_path(served_on: @served_on.prev_day), class: 'btn btn-sm btn-outline-secondary'
  = form_with url: admins_orders_path, method: :get, class: 'd-flex gap-2', data: { test_id: 'order-search' } do |f|
    = f.label :served_on, '提供日', class: 'visually-hidden'
    = f.date_field :served_on, value: @served_on, class: 'form-control form-control-sm'
    = f.submit '表示', name: nil, class: 'btn btn-sm btn-primary'
  = link_to '次の日 ›', admins_orders_path(served_on: @served_on.next_day), class: 'btn btn-sm btn-outline-secondary'
%h2.h5.mb-3 #{I18n.l(@served_on, format: :with_wday)} 提供分
- if @orders.empty?
  %p.text-body-secondary この提供日の注文はありません。
- else
  .table-responsive.bg-white.border.rounded
    %table.table.align-middle.mb-0
      %thead.text-nowrap
        %tr
          %th{ scope: 'col' } 注文番号
          %th{ scope: 'col' }= Order.human_attribute_name(:user)
          %th{ scope: 'col' } 弁当
          %th.text-end{ scope: 'col' }= Order.human_attribute_name(:quantity)
          %th{ scope: 'col' }= Order.human_attribute_name(:delivery_area)
          %th.text-end{ scope: 'col' } 合計金額（税込）
          %th{ scope: 'col' }= Order.human_attribute_name(:status)
      %tbody
        - @orders.each do |order|
          %tr{ data: { test_id: dom_id(order) } }
            %td.text-nowrap= link_to "##{order.id}", admins_order_path(order)
            %td.text-nowrap= order.user.name
            %td.text-nowrap= order.daily_menu.bento.name
            %td.text-end.text-nowrap #{order.quantity} 個
            %td.text-nowrap= order.delivery_area.name
            %td.text-end.text-nowrap= number_to_currency(order.total_price)
            %td= order_status_badge(order)
