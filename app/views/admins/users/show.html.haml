- content_for :title, @user.name
%nav{ aria: { label: 'パンくずリスト' } }
  %ol.breadcrumb
    %li.breadcrumb-item= link_to '利用者', admins_users_path
    %li.breadcrumb-item.active{ aria: { current: 'page' } }= @user.name
%section.card.shadow-sm.mb-4
  .card-body
    %h1.h4.mb-3= @user.name
    %dl.row.mb-0
      %dt.col-sm-3= User.human_attribute_name(:email)
      %dd.col-sm-9= @user.email
      %dt.col-sm-3= User.human_attribute_name(:phone_number)
      %dd.col-sm-9= @user.phone_number
      %dt.col-sm-3 登録日
      %dd.col-sm-9.mb-0= I18n.l(@user.created_at.to_date)
%section
  %h2.h5.mb-3 請求
  %nav.d-flex.justify-content-between.align-items-center.mb-3{ 'aria-label': '請求する月' }
    = link_to '‹ 前の月', admins_user_path(@user, month: @month.prev_month.strftime('%Y-%m')), class: 'btn btn-sm btn-outline-secondary'
    %h3.h5.mb-0= I18n.l(@month, format: :month)
    = link_to '次の月 ›', admins_user_path(@user, month: @month.next_month.strftime('%Y-%m')), class: 'btn btn-sm btn-outline-secondary'
  .card.shadow-sm.mb-3
    .card-body.d-flex.justify-content-between.align-items-center
      %span 請求額（税込）
      %span.h4.mb-0{ data: { test_id: 'billing-amount' } }= number_to_currency(@billing_amount)
  %p.small.text-body-secondary 提供日がこの月の注文のうち、キャンセル済みを除いた合計金額です。
  - if @orders.empty?
    %p.text-body-secondary この月の注文はありません。
  - else
    .table-responsive.bg-white.border.rounded
      %table.table.align-middle.mb-0
        %thead.text-nowrap
          %tr
            %th{ scope: 'col' } 提供日
            %th{ scope: 'col' } 弁当
            %th.text-end{ scope: 'col' }= Order.human_attribute_name(:quantity)
            %th.text-end{ scope: 'col' } 合計金額（税込）
            %th{ scope: 'col' }= Order.human_attribute_name(:status)
        %tbody
          - @orders.each do |order|
            %tr{ data: { test_id: dom_id(order) } }
              %td.text-nowrap= link_to I18n.l(order.daily_menu.served_on, format: :with_wday), admins_order_path(order)
              %td.text-nowrap= order.daily_menu.bento.name
              %td.text-end.text-nowrap #{order.quantity} 個
              %td.text-end.text-nowrap= number_to_currency(order.total_price)
              %td= order_status_badge(order)
