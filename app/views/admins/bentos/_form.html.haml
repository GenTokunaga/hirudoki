= simple_form_for [:admins, bento] do |f|
  = f.error_notification
  = f.input :name, input_html: { maxlength: 50 }
  = f.input :description, input_html: { rows: 4 }
  = f.input :bento_type, collection: bento_type_options, include_blank: false
  = f.input :price, hint: '1個あたりの税抜価格を円で入力してください。', input_html: { min: 0, step: 1 }
  = f.input :position, hint: '小さい順に表示します。', input_html: { step: 1 }
  = f.input :on_sale, label: '販売する', hint: '外すと利用者の献立一覧に表示されなくなります。'
  - if bento.image.attached? && bento.image.persisted?
    .mb-2= bento_image_tag(bento, size: 120)
  = f.input :image, as: :file, hint: 'JPEG・PNG・WebP（5MB まで）。選び直すと差し替えます。', input_html: { accept: Bento::IMAGE_CONTENT_TYPES.join(',') }
  .d-flex.flex-wrap.gap-2
    = f.button :submit, submit_label, class: 'btn-primary', data: { turbo_submits_with: '保存中…' }
    = link_to 'キャンセル', admins_bentos_path, class: 'btn btn-outline-secondary'
