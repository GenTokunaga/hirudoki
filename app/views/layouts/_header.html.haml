%header
  %nav.navbar.navbar-expand.border-bottom{ class: admin_area? ? 'navbar-dark bg-dark' : 'bg-white', 'aria-label': 'メインナビゲーション' }
    .container
      - if admin_area?
        = link_to 'ひるどき', admins_bentos_path, class: 'navbar-brand fw-bold'
      - else
        = link_to 'ひるどき', root_path, class: 'navbar-brand fw-bold'
      %ul.navbar-nav.header-nav.ms-auto.align-items-center
        - if admin_area?
          - if admin_signed_in?
            %li.nav-item= nav_link_to '弁当', admins_bentos_path, icon: 'bi-fork-knife'
            %li.nav-item= nav_link_to '配達エリア', admins_delivery_areas_path, icon: 'bi-map'
            %li.nav-item= nav_link_to '日別献立', admins_daily_menus_path, icon: 'bi-calendar-week'
            %li.nav-item= nav_link_to '注文', admins_orders_path, icon: 'bi-receipt'
            %li.nav-item= nav_link_to '製造・配達', admins_delivery_list_path, icon: 'bi-truck'
            %li.nav-item= nav_link_to '利用者', admins_users_path, icon: 'bi-people'
            %li.nav-item= nav_link_to 'マイページ', admins_mypage_path, icon: 'bi-person-circle'
        - else
          %li.nav-item= nav_link_to '献立', root_path, icon: 'bi-calendar-week'
          - if user_signed_in?
            %li.nav-item= nav_link_to 'マイページ', mypage_path, icon: 'bi-person-circle', current: mypage_section?
          - else
            %li.nav-item= nav_link_to 'ログイン', new_user_session_path, icon: 'bi-box-arrow-in-right'
            %li.nav-item= nav_link_to '新規登録', new_user_registration_path, icon: 'bi-person-plus'
