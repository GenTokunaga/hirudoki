<header>
  <nav class="navbar navbar-expand-md border-bottom <%= admin_area? ? "navbar-dark bg-dark" : "bg-white" %>"
       aria-label="メインナビゲーション">
    <div class="container">
      <% if admin_area? %>
        <%= link_to admin_root_path, class: "navbar-brand fw-bold" do %>
          ひるどき <span class="badge text-bg-warning align-text-top">管理</span>
        <% end %>
      <% else %>
        <%= link_to "ひるどき", root_path, class: "navbar-brand fw-bold" %>
      <% end %>

      <button class="navbar-toggler" type="button"
              data-bs-toggle="collapse" data-bs-target="#global-nav"
              aria-controls="global-nav" aria-expanded="false" aria-label="メニューを開く">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="global-nav">
        <ul class="navbar-nav ms-auto align-items-md-center">
          <% if admin_area? %>
            <% if admin_signed_in? %>
              <li class="nav-item"><%= nav_link_to "ダッシュボード", admin_root_path %></li>
              <li class="nav-item">
                <%= button_to "ログアウト", destroy_admin_session_path, method: :delete,
                              class: "nav-link btn btn-link" %>
              </li>
            <% end %>
          <% else %>
            <li class="nav-item"><%= nav_link_to "献立", root_path %></li>
            <% if user_signed_in? %>
              <li class="nav-item"><%= nav_link_to "アカウント", edit_user_registration_path %></li>
              <li class="nav-item">
                <%= button_to "ログアウト", destroy_user_session_path, method: :delete,
                              class: "nav-link btn btn-link" %>
              </li>
            <% else %>
              <li class="nav-item"><%= nav_link_to "ログイン", new_user_session_path %></li>
              <li class="nav-item"><%= nav_link_to "新規登録", new_user_registration_path %></li>
            <% end %>
          <% end %>
        </ul>
      </div>
    </div>
  </nav>
</header>
